#version 330 core

// Input vertex data, different for all executions of this shader.
layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec2 vertexUV;   // NEW: texture coordinate (u,v) per vertex

// Output data: passed on to the fragment shader and interpolated per pixel
out vec2 UV;

void main(){

    gl_Position.xyz = vertexPosition_modelspace;
    gl_Position.w = 1.0;

    // Simply pass the texture coordinate on
    UV = vertexUV;
}
