#version 330 core

// Interpolated texture coordinate from the vertex shader
in vec2 UV;

// Ouput data
out vec3 color;

// The texture that is currently bound (set from the C++ code)
uniform sampler2D myTextureSampler;

void main()
{

	// Color of the texture at the given UV coordinate
	vec3 texColor = texture(myTextureSampler, UV).rgb;

	// Simulated alpha channel ("color key"): white pixels count as transparent.
	// discard throws the fragment away, so whatever was drawn before (the clock face) stays visible.
	// Note: the clock face itself must not contain pure white, otherwise it gets holes as well.
	if (texColor.r > 0.95 && texColor.g > 0.95 && texColor.b > 0.95)
		discard;

	color = texColor;

}
